{
  "name": "dsh-lan-access",
  "version": "0.1.0",
  "description": "在 DeepSeek Harness 的远程连接设置中添加局域网访问开关",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongx114/dsh-lan-access.git"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "lan-listener.js", "client.js", "cordis.patch.yml"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-remote-connection"]
    }
  }
}
